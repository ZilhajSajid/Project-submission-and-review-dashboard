model User {
  id       String   @id @default(uuid()) @db.Uuid
  email    String   @unique
  name     String
  password String
  phone    String?
  userRole UserRole @default(STUDENT)

  useStatus UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectSubmission Submission? @relation("StudentSubmission")

  reviewedSubmissions Submission[] @relation("SubmissionReviewer")

  @@map("users")
}
